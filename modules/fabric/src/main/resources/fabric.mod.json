{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "contact": {
    "sources": "${mod_sources}",
    "homepage": "${mod_homepage}"
  },
  "icon": "assets/bl_accessories_layer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.oxcodsnet.bl_accessories_layer.fabric.ExampleModFabric"
    ],
    "client": [
      "net.oxcodsnet.bl_accessories_layer.fabric.client.ExampleModFabricClient"
    ]
  },
  "mixins": [
    "bl_accessories_layer.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "beltborne_lanterns": ">=${beltborne_lanterns_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "${modmenu_version}"
  }
}

